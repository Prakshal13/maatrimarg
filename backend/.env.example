# MaatriMarg Backend Environment Configuration

# 1. Local SQLite (Default - zero setup)
DATABASE_URL=sqlite:///./maatrimarg.db

# 2. Supabase PostgreSQL (Production / Cloud)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres
# DATABASE_URL=postgresql://postgres:your-supabase-password@db.xxxxxx.supabase.co:5432/postgres

# Port & Host configuration (optional)
PORT=8000
HOST=0.0.0.0
